+from requests.sessions import Session
+from urllib.parse import urlparse
+
+def test_rebuild_proxies():
+    session = Session()
+
+    # Mock data for testing
+    prepared_request = type('PreparedRequest', (object,), {"url": "http://example.com", "headers": {}})()
+    proxies = {
+        'http': 'http://user:pass@127.0.0.1:8080',
+        'https': 'http://user:pass@127.0.0.1:8080',
+    }
+
+    # Call the rebuild_proxies method
+    new_proxies = session.rebuild_proxies(prepared_request, proxies)
+
+    # Check the result
+    for scheme, proxy in new_proxies.items():
+        parsed_proxy = urlparse(proxy)
+        assert parsed_proxy.username is None, f"Username should be stripped from {scheme} proxy"
+        assert parsed_proxy.password is None, f"Password should be stripped from {scheme} proxy"
+        print(f"{scheme} proxy after rebuild: {proxy}")
+
+if __name__ == "__main__":
+    test_rebuild_proxies()
