{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PX062BucketMetadata",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::praxis-garypagan-272615233626-us-east-1"
    },
    {
      "Sid": "PX062ListOnlyExperimentPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::praxis-garypagan-272615233626-us-east-1",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "experiments/px062-skill-provenance/gate2-hallucination-20260724",
            "experiments/px062-skill-provenance/gate2-hallucination-20260724/*"
          ]
        }
      }
    },
    {
      "Sid": "PX062ReadSubmittedCode",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::praxis-garypagan-272615233626-us-east-1/experiments/px062-skill-provenance/gate2-hallucination-20260724/code/*/source.tar.gz"
    },
    {
      "Sid": "PX062WriteTrainingOutput",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::praxis-garypagan-272615233626-us-east-1/experiments/px062-skill-provenance/gate2-hallucination-20260724/output/*"
    }
  ]
}
