{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PX057BucketInformation",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::praxis-garypagan-272615233626-us-east-1"
    },
    {
      "Sid": "PX057ListPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::praxis-garypagan-272615233626-us-east-1",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "experiments/px057-adaptive-stopping/gate1-gpu-pilot-20260723",
            "experiments/px057-adaptive-stopping/gate1-gpu-pilot-20260723/*",
            "experiments/px057-adaptive-stopping/gate2-full-20260724",
            "experiments/px057-adaptive-stopping/gate2-full-20260724/*"
          ]
        }
      }
    },
    {
      "Sid": "PX057ObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::praxis-garypagan-272615233626-us-east-1/experiments/px057-adaptive-stopping/gate1-gpu-pilot-20260723/*",
        "arn:aws:s3:::praxis-garypagan-272615233626-us-east-1/experiments/px057-adaptive-stopping/gate2-full-20260724/*"
      ]
    }
  ]
}
