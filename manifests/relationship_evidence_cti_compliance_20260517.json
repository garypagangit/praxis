  "hypothesis": "Question-ranked ATT&CK evidence improves strict CTI-MCQ answer compliance over vanilla prompting and broad CTI seed prompting. Relationship evidence is the strongest tested retrieval form, but the ablation bounds the mechanism because technique-only evidence also helps.",
  "falsification_criteria": [
    "Relationship evidence fails to beat vanilla strict accuracy by at least +0.030.",
    "Relationship evidence fails to beat technique-only retrieval by at least +0.030 in the ablation gate.",
    "Relationship evidence has a higher invalid response rate than vanilla.",
    "Evidence-only paired wins do not exceed vanilla-only paired wins.",
    "The result depends on using labels during prompt construction or dropping invalid outputs."
  ],
  "datasets": [
    {
      "id": "ctibench",
      "local_paths": [
        "runs/sec-lord-cti-scaffold-20260509/cti_mcq_queries.jsonl"
