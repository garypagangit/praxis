      "path": "C:/w/px010_dev/final_praxis/010_development_20260915/D0_PROTOCOL.md",
      "locators": [
        {
          "heading": "Research question and hypothesis",
          "supports": "Raw joint spillover >=0.05 in >=8 of 32 contexts and mean error inflation >=0.02, both in the same >=2 perturbation variants; qualifying spillover must exceed numerical floor."
        },
        {
          "heading": "Public-data base and fixed construction",
          "supports": "Previously used NAB/TSB-AD series; semisynthetic three-channel construction; overlapping 128-step contexts; unchanged channels and targets."
        },
        {
          "heading": "Metrics, audit and decision",
          "supports": "Spillover and error inflation first average unchanged channels 1 and 2; variant means equally weight all 32 contexts; clean MAE uses all 64 scalar targets. Clean-repeat discrepancy >1e-5 or independent spillover >floor yields operational HOLD. Either preprocessing baseline suffices only if all qualifying variant means <=0.005 and clean-MAE increase <=0.01."
        },
        {
          "heading": "What a later D1 must establish",
          "supports": "Directional information access is prospective; compare independent forecasts, trusted-channel reconstruction, dual-reference controls, clipping and qualified prior methods. Natural multivariate telemetry and retention/recovery outcomes require separate prospective work."
        },
        {
          "heading": "Execution boundary",
          "supports": "Commit executable worker and freeze environment with source-bound controls before processing; one host, 30-minute host cap, $10 combined reserve, external stop protection and verified shutdown."
        }
      ]
    },
